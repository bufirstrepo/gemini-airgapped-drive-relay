{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bufirstrepo/gemini-airgapped-drive-relay/schemas/artifact-manifest.schema.json",
  "title": "AGCDR Artifact Manifest",
  "description": "Manifest written last (atomic commit marker) into a drive.file-scoped Google Drive staging folder. The local pull verifier checks every field below before any staged file is executed.",
  "type": "object",
  "required": [
    "manifest_version",
    "run_id",
    "created_utc",
    "origin_plane",
    "sandbox_attestation",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "origin_plane": {
      "type": "object",
      "required": [
        "drive_scope"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "examples": [
            "gemini-live-voice"
          ]
        },
        "engine": {
          "type": "string",
          "examples": [
            "antigravity-2.0-worker"
          ]
        },
        "drive_scope": {
          "const": "https://www.googleapis.com/auth/drive.file"
        }
      }
    },
    "sandbox_attestation": {
      "type": "object",
      "required": [
        "runtime",
        "inbound_tunnel_open"
      ],
      "properties": {
        "runtime": {
          "const": "gvisor-runsc"
        },
        "network_egress_policy": {
          "type": "string",
          "examples": [
            "allowlist-only"
          ]
        },
        "inbound_tunnel_open": {
          "const": false
        }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "implementation_plan": {
          "type": "string"
        },
        "test_summary": {
          "type": "object",
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "relative_path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "description": "POSIX relative path. Absolute paths, '..', '.', empty segments and backslashes are rejected.",
            "not": {
              "anyOf": [
                {
                  "pattern": "^/"
                },
                {
                  "pattern": "\\\\"
                },
                {
                  "pattern": "(^|/)\\.{1,2}(/|$)"
                },
                {
                  "pattern": "//"
                }
              ]
            }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "executable_warning": {
            "type": "boolean",
            "description": "True flags the file for human diff review before local execution."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
